# Brain provider: "ollama" (default, 100% local) or "claude-cli" (optional)
BRAIN_PROVIDER=ollama

# Ollama settings (no API key needed)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional: comma-separated WhatsApp JIDs to allow besides your own "Message Yourself" chat
# Leave empty to only respond in your own "Message Yourself" chat.
ALLOWED_CHATS=

# How many recent messages to keep per chat for context
MAX_HISTORY_MESSAGES=16

# Reminder check interval in seconds
REMINDER_CHECK_SECONDS=30

# Directory for reminders, notes, and chat history
DATA_DIR=./data

# Directory for WhatsApp session credentials
AUTH_DIR=./auth_info
