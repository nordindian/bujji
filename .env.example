# Brain provider: "gemini" (recommended), "ollama" (local), or "claude-cli"
BRAIN_PROVIDER=gemini

# Gemini API (get a free key at https://aistudio.google.com)
# NEVER commit your real .env file to GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Spend Guardrail: stops Gemini calls when estimated USD spend reaches this limit
GEMINI_BUDGET_LIMIT_USD=1.00

# Optional email alert when guardrail triggers (e.g., Gmail + App Password)
ALERT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Ollama settings (used only when BRAIN_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional: comma-separated WhatsApp JIDs (e.g. a 1-person "Bujji" group JID)
# Leave empty to use "Message Yourself", or send /setchat in a group to get its JID.
ALLOWED_CHATS=

# Local Notion-style Web Dashboard port (0 to disable)
WEB_PORT=3000

# How many recent messages to keep per chat for context
MAX_HISTORY_MESSAGES=16

# Reminder check interval in seconds
REMINDER_CHECK_SECONDS=30

# Directory for reminders, notes, tasks, and usage data
DATA_DIR=./data

# Directory for WhatsApp session credentials
AUTH_DIR=./auth_info
